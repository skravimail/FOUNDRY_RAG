# Foundry project + model deployments
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_CHAT_DEPLOYMENT=<chat-model-deployment-name>
FOUNDRY_EMBEDDING_DEPLOYMENT=<embedding-model-deployment-name>

# Azure AI Search (Standard+ for Foundry IQ Knowledge Bases; Free tier is not enough for MI/KB)
AZURE_AI_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_AI_SEARCH_CONNECTION_NAME=<foundry-search-connection-name>
AZURE_AI_SEARCH_KNOWLEDGE_BASE=<knowledge-base-name-for-foundryiq>
AZURE_AI_SEARCH_KNOWLEDGE_SOURCE=<blob-knowledge-source-name>

# Blob Storage for T2-RAGBench PDFs (Phase 0/2)
AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>
AZURE_STORAGE_CONTAINER=t2-ragbench

# Local Postgres + pgvector (docker compose up -d)
DATABASE_URL=postgresql://foundry:foundry@localhost:5432/t2_ragbench
FOUNDRY_EMBEDDING_DIMENSIONS=1536

# Auth is via DefaultAzureCredential (az login / managed identity) — no API keys.
