# Foundry project + model deployments
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_CHAT_DEPLOYMENT=<chat-model-deployment-name>
FOUNDRY_EMBEDDING_DEPLOYMENT=<embedding-model-deployment-name>

# Azure AI Search (modules 02 HybridRAG, 03 ReRankingRAG, 04 MultiQueryRAG, 09 FoundryIQ)
AZURE_AI_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_AI_SEARCH_CONNECTION_NAME=<foundry-search-connection-name>

# Neo4j (module 08 GraphRAG only)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<neo4j-password>

# Auth is via DefaultAzureCredential (az login / managed identity) — no API keys.
